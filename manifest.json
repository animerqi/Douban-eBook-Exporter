{
  "manifest_version": 3,
  "name": "Douban eBook Exporter",
  "version": "1.18",
  "description": "导出豆瓣阅读的电子书",
  "permissions": ["activeTab", "downloads", "scripting", "storage"],
  "host_permissions": ["https://read.douban.com/*", "https://pic.arkread.com/*"],
  "background": {
    "service_worker": "js/background.js"
  },
  "action": {
    "default_popup": "html/popup.html",
    "default_icon": {
      "16": "images/icon_16x16.png",
      "48": "images/icon_48x48.png",
      "128": "images/icon_128x128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://read.douban.com/reader/*"],
      "js": ["js/content.js"]
    }
  ],
  "icons": {
    "16": "images/icon_16x16.png",
    "48": "images/icon_48x48.png",
    "128": "images/icon_128x128.png"
  }
}
